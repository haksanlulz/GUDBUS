# --- Core (required) -------------------------------------------------------
DISCORD_TOKEN=your_bot_token_here
DATABASE_URL=sqlite+aiosqlite:///data/gurps_bot.db

# --- Command sync (optional) ----------------------------------------------
# Slash commands register themselves globally at startup, and only when the
# command set actually changed (fingerprint in data/.command_fingerprint).
# Set AUTO_SYNC=0 to disable. Rescue if registrations are ever gone: mention
# the bot — "@<bot> sync" (owner-only; needs no slash commands to exist).
AUTO_SYNC=

# --- Scaling (optional) ----------------------------------------------------
# Acknowledge an interaction before touching the database. OFF by default.
# Discord kills an un-deferred interaction after 3 seconds; SQLite waits up to
# 5s for a write lock, so a contended write can outlive the token and the user
# sees "The application did not respond" on a command that worked. Deferring
# moves that ceiling to 15 minutes, at the cost of Discord showing
# "<bot> is thinking..." until the reply lands.
# Not worth it for one table: a combat write takes ~10ms and the wall is
# unreachable. Set to 1 when tables get busy enough that writes overlap, if
# "did not respond" ever shows up at a table, or before going public.
DEFER_INTERACTIONS=

# --- Legal / about (/legal, /about) ---------------------------------------
# The SJG Online Policy requires the game aid be attributed to its author.
BOT_AUTHOR_LEGAL_NAME=
# Optional links shown in /legal and /about.
BOT_INVITE_URL=
BOT_SUPPORT_URL=

# --- Donation links (/support, /donate) -----------------------------------
# All optional. Only configured https links are shown; with none set, the
# command shows a "best support is sharing the bot" message. The bot never
# handles payments; these just link out to the platforms.
KOFI_URL=
BUYMEACOFFEE_URL=
PATREON_URL=
GITHUB_SPONSORS_URL=
PAYPAL_URL=
LIBERAPAY_URL=
# Optional: override the thank-you blurb at the top of the /support embed.
SUPPORT_MESSAGE=
