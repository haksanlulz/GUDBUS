# --- Core (required) -------------------------------------------------------
DISCORD_TOKEN=your_bot_token_here
DATABASE_URL=sqlite+aiosqlite:///data/gurps_bot.db

# --- Command sync (optional) ----------------------------------------------
# Slash commands register themselves globally at startup, and only when the
# command set actually changed (fingerprint in data/.command_fingerprint).
# Set AUTO_SYNC=0 to disable. Rescue if registrations are ever gone: mention
# the bot — "@<bot> sync" (owner-only; needs no slash commands to exist).
AUTO_SYNC=

# --- Scaling (optional) ----------------------------------------------------
# Acknowledge an interaction before touching the database.
# Discord kills an un-deferred interaction after 3 seconds; SQLite waits up to
# 5s for a write lock, so a contended write can outlive the token and the user
# sees "The application did not respond" on a command that worked. Deferring
# moves that ceiling to 15 minutes, at the cost of Discord showing
# "<bot> is thinking..." until the reply lands.
# ON by default, because a published bot runs on hardware nobody has measured
# and the margin was already under 2x at 120 concurrent writes on an SSD. The
# trade is asymmetric: deferring costs a flicker, not deferring costs a user
# seeing "did not respond" on a command that worked.
# Set to 0 for a single-table instance on a fast disk, where a combat write
# takes ~10ms, the 3-second wall is unreachable, and the flicker buys nothing.
DEFER_INTERACTIONS=

# --- Legal / about (/legal, /about) ---------------------------------------
# The SJG Online Policy notice credits the game aid's author: whoever wrote the
# code, not whoever hosts it. Defaults to the project's author; a fork with its
# own changes sets its own. A consistent handle or pen name is fine.
# (BOT_AUTHOR_LEGAL_NAME, the old name, is still read.)
BOT_AUTHOR_NAME=
# Shown as "Hosted by ..." in /legal when set.
BOT_OPERATOR_NAME=
# Links shown in /legal. If you host the bot for others, set a support link:
# it is how users reach you about their data.
BOT_INVITE_URL=
BOT_SUPPORT_URL=
# Where /legal links the privacy policy and terms. Default: this project's
# PRIVACY.md and TERMS.md. If you host for others, publish your own.
BOT_PRIVACY_URL=
BOT_TERMS_URL=
